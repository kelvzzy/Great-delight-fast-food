generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model audit_logs {
  id          String   @id
  user_id     String?
  action      String
  entity_type String
  entity_id   String
  details     String?
  ip_address  String?
  created_at  DateTime @default(now())

  @@index([created_at])
  @@index([entity_type, entity_id])
  @@index([user_id])
}

model branches {
  id              String            @id
  restaurant_id   String
  name            String
  slug            String
  address         String?
  phone           String?
  active          Boolean           @default(true)
  created_at      DateTime          @default(now())
  updated_at      DateTime
  restaurants     restaurants       @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  menu_categories menu_categories[]
  orders          orders[]
  tables          tables[]
  users           users[]

  @@unique([restaurant_id, slug])
  @@index([restaurant_id])
  @@index([slug])
}

model menu_categories {
  id          String       @id
  branch_id   String
  name        String
  slug        String
  description String?
  image       String?
  active      Boolean      @default(true)
  sort_order  Int          @default(0)
  created_at  DateTime     @default(now())
  updated_at  DateTime
  branches    branches     @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  menu_items  menu_items[]

  @@unique([branch_id, slug])
  @@index([branch_id])
  @@index([slug])
}

model menu_items {
  id              String          @id
  category_id     String
  name            String
  slug            String
  description     String?
  image           String?
  base_price      Int?
  active          Boolean         @default(true)
  available       Boolean         @default(true)
  sort_order      Int             @default(0)
  created_at      DateTime        @default(now())
  updated_at      DateTime
  menu_categories menu_categories @relation(fields: [category_id], references: [id], onDelete: Cascade)
  menu_options    menu_options[]
  menu_variants   menu_variants[]
  order_items     order_items[]

  @@unique([category_id, slug])
  @@index([available])
  @@index([category_id])
  @@index([slug])
}

model menu_option_values {
  id                 String               @id
  option_id          String
  name               String
  price_modifier     Int                  @default(0)
  active             Boolean              @default(true)
  available          Boolean              @default(true)
  sort_order         Int                  @default(0)
  created_at         DateTime             @default(now())
  updated_at         DateTime
  menu_options       menu_options         @relation(fields: [option_id], references: [id], onDelete: Cascade)
  order_item_options order_item_options[]

  @@index([option_id])
}

model menu_options {
  id                 String               @id
  menu_item_id       String
  name               String
  required           Boolean              @default(false)
  sort_order         Int                  @default(0)
  created_at         DateTime             @default(now())
  updated_at         DateTime
  menu_option_values menu_option_values[]
  menu_items         menu_items           @relation(fields: [menu_item_id], references: [id], onDelete: Cascade)

  @@index([menu_item_id])
}

model menu_variants {
  id                  String                @id
  menu_item_id        String
  name                String
  price               Int
  active              Boolean               @default(true)
  available           Boolean               @default(true)
  sort_order          Int                   @default(0)
  created_at          DateTime              @default(now())
  updated_at          DateTime
  menu_items          menu_items            @relation(fields: [menu_item_id], references: [id], onDelete: Cascade)
  order_item_variants order_item_variants[]

  @@index([menu_item_id])
}

model order_item_options {
  id                 String             @id
  order_item_id      String
  option_value_id    String
  option_name        String
  value_name         String
  price_modifier     Int                @default(0)
  menu_option_values menu_option_values @relation(fields: [option_value_id], references: [id])
  order_items        order_items        @relation(fields: [order_item_id], references: [id], onDelete: Cascade)

  @@index([option_value_id])
  @@index([order_item_id])
}

model order_item_variants {
  id            String        @id
  order_item_id String        @unique
  variant_id    String
  variant_name  String
  variant_price Int
  order_items   order_items   @relation(fields: [order_item_id], references: [id], onDelete: Cascade)
  menu_variants menu_variants @relation(fields: [variant_id], references: [id])

  @@index([order_item_id])
  @@index([variant_id])
}

model order_items {
  id                  String               @id
  order_id            String
  menu_item_id        String
  item_name           String
  item_price          Int?
  quantity            Int                  @default(1)
  subtotal            Int
  created_at          DateTime             @default(now())
  order_item_options  order_item_options[]
  order_item_variants order_item_variants?
  menu_items          menu_items           @relation(fields: [menu_item_id], references: [id])
  orders              orders               @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([menu_item_id])
  @@index([order_id])
}

model orders {
  id                   String        @id
  order_number         String        @unique
  branch_id            String
  table_id             String
  status               OrderStatus   @default(NEW)
  customer_name        String?
  customer_phone       String?
  special_note         String?
  subtotal             Int
  total                Int
  item_count           Int           @default(0)
  is_gift              Boolean       @default(false)
  gift_sender_name     String?
  gift_sender_phone    String?
  gift_recipient_name  String?
  gift_recipient_phone String?
  gift_message         String?
  gift_claim_code      String?       @unique
  gift_claimed         Boolean       @default(false)
  gift_claimed_at      DateTime?
  created_at           DateTime      @default(now())
  updated_at           DateTime
  accepted_at          DateTime?
  preparing_at         DateTime?
  ready_at             DateTime?
  completed_at         DateTime?
  cancelled_at         DateTime?
  order_items          order_items[]
  branches             branches      @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  tables               tables        @relation(fields: [table_id], references: [id])

  @@index([branch_id])
  @@index([created_at])
  @@index([gift_claim_code])
  @@index([gift_recipient_phone])
  @@index([is_gift, gift_claimed])
  @@index([is_gift])
  @@index([order_number])
  @@index([status])
  @@index([table_id])
}

model restaurants {
  id          String     @id
  name        String
  slug        String     @unique
  description String?
  logo        String?
  active      Boolean    @default(true)
  created_at  DateTime   @default(now())
  updated_at  DateTime
  branches    branches[]
  users       users[]

  @@index([slug])
}

model tables {
  id         String   @id
  branch_id  String
  name       String
  slug       String
  qr_code    String?
  active     Boolean  @default(true)
  sort_order Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime
  orders     orders[]
  branches   branches @relation(fields: [branch_id], references: [id], onDelete: Cascade)

  @@unique([branch_id, slug])
  @@index([branch_id])
  @@index([slug])
}

model users {
  id            String       @id
  email         String       @unique
  password_hash String
  first_name    String
  last_name     String
  role          Role         @default(STAFF)
  active        Boolean      @default(true)
  restaurant_id String?
  branch_id     String?
  created_at    DateTime     @default(now())
  updated_at    DateTime
  last_login_at DateTime?
  branches      branches?    @relation(fields: [branch_id], references: [id])
  restaurants   restaurants? @relation(fields: [restaurant_id], references: [id])

  @@index([branch_id])
  @@index([email])
  @@index([restaurant_id])
}

enum OrderStatus {
  NEW
  ACCEPTED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum Role {
  SUPER_ADMIN
  RESTAURANT_ADMIN
  MANAGER
  STAFF
}
