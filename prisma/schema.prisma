generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String      @map("password_hash")
  firstName    String      @map("first_name")
  lastName     String      @map("last_name")
  role         Role        @default(STAFF)
  active       Boolean     @default(true)
  restaurantId String?     @map("restaurant_id")
  branchId     String?     @map("branch_id")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  lastLoginAt  DateTime?   @map("last_login_at")
  branch       Branch?     @relation(fields: [branchId], references: [id])
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id])

  @@index([restaurantId])
  @@index([branchId])
  @@index([email])
  @@map("users")
}

model Restaurant {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  logo        String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  branches    Branch[]
  users       User[]

  @@index([slug])
  @@map("restaurants")
}

model Branch {
  id             String         @id @default(uuid())
  restaurantId   String         @map("restaurant_id")
  name           String
  slug           String
  address        String?
  phone          String?
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  restaurant     Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuCategories MenuCategory[]
  orders         Order[]
  tables         Table[]
  users          User[]

  @@unique([restaurantId, slug])
  @@index([restaurantId])
  @@index([slug])
  @@map("branches")
}

model Table {
  id        String   @id @default(uuid())
  branchId  String   @map("branch_id")
  name      String
  slug      String
  qrCode    String?  @map("qr_code")
  active    Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  orders    Order[]
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, slug])
  @@index([branchId])
  @@index([slug])
  @@map("tables")
}

model MenuCategory {
  id          String     @id @default(uuid())
  branchId    String     @map("branch_id")
  name        String
  slug        String
  description String?
  image       String?
  active      Boolean    @default(true)
  sortOrder   Int        @default(0) @map("sort_order")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  branch      Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  menuItems   MenuItem[]

  @@unique([branchId, slug])
  @@index([branchId])
  @@index([slug])
  @@map("menu_categories")
}

model MenuItem {
  id          String        @id @default(uuid())
  categoryId  String        @map("category_id")
  name        String
  slug        String
  description String?
  image       String?
  basePrice   Int?          @map("base_price")
  active      Boolean       @default(true)
  available   Boolean       @default(true)
  sortOrder   Int           @default(0) @map("sort_order")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  category    MenuCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  options     MenuOption[]
  variants    MenuVariant[]
  orderItems  OrderItem[]

  @@unique([categoryId, slug])
  @@index([categoryId])
  @@index([slug])
  @@index([available])
  @@map("menu_items")
}

model MenuVariant {
  id                String             @id @default(uuid())
  menuItemId        String             @map("menu_item_id")
  name              String
  price             Int
  active            Boolean            @default(true)
  available         Boolean            @default(true)
  sortOrder         Int                @default(0) @map("sort_order")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  menuItem          MenuItem           @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  orderItemVariants OrderItemVariant[]

  @@index([menuItemId])
  @@map("menu_variants")
}

model MenuOption {
  id         String            @id @default(uuid())
  menuItemId String            @map("menu_item_id")
  name       String
  required   Boolean           @default(false)
  sortOrder  Int               @default(0) @map("sort_order")
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")
  values     MenuOptionValue[]
  menuItem   MenuItem          @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([menuItemId])
  @@map("menu_options")
}

model MenuOptionValue {
  id               String            @id @default(uuid())
  optionId         String            @map("option_id")
  name             String
  priceModifier    Int               @default(0) @map("price_modifier")
  active           Boolean           @default(true)
  available        Boolean           @default(true)
  sortOrder        Int               @default(0) @map("sort_order")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  option           MenuOption        @relation(fields: [optionId], references: [id], onDelete: Cascade)
  orderItemOptions OrderItemOption[]

  @@index([optionId])
  @@map("menu_option_values")
}

model Order {
  id                 String      @id @default(uuid())
  orderNumber        String      @unique @map("order_number")
  branchId           String      @map("branch_id")
  tableId            String      @map("table_id")
  status             OrderStatus @default(NEW)
  customerName       String?     @map("customer_name")
  customerPhone      String?     @map("customer_phone")
  specialNote        String?     @map("special_note")
  subtotal           Int
  total              Int
  itemCount          Int         @default(0) @map("item_count")
  isGift             Boolean     @default(false) @map("is_gift")
  giftSenderName     String?     @map("gift_sender_name")
  giftSenderPhone    String?     @map("gift_sender_phone")
  giftRecipientName  String?     @map("gift_recipient_name")
  giftRecipientPhone String?     @map("gift_recipient_phone")
  giftMessage        String?     @map("gift_message") @db.Text
  giftClaimCode      String?     @unique @map("gift_claim_code")
  giftClaimed        Boolean     @default(false) @map("gift_claimed")
  giftClaimedAt      DateTime?   @map("gift_claimed_at")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")
  acceptedAt         DateTime?   @map("accepted_at")
  preparingAt        DateTime?   @map("preparing_at")
  readyAt            DateTime?   @map("ready_at")
  completedAt        DateTime?   @map("completed_at")
  cancelledAt        DateTime?   @map("cancelled_at")
  items              OrderItem[]
  branch             Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  table              Table       @relation(fields: [tableId], references: [id])

  @@index([branchId])
  @@index([tableId])
  @@index([status])
  @@index([orderNumber])
  @@index([createdAt])
  @@index([giftClaimCode])
  @@index([isGift, giftClaimed])
  @@map("orders")
}

model OrderItem {
  id         String            @id @default(uuid())
  orderId    String            @map("order_id")
  menuItemId String            @map("menu_item_id")
  itemName   String            @map("item_name")
  itemPrice  Int?              @map("item_price")
  quantity   Int               @default(1)
  subtotal   Int
  createdAt  DateTime          @default(now()) @map("created_at")
  options    OrderItemOption[]
  variant    OrderItemVariant?
  menuItem   MenuItem          @relation(fields: [menuItemId], references: [id])
  order      Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([menuItemId])
  @@map("order_items")
}

model OrderItemVariant {
  id           String      @id @default(uuid())
  orderItemId  String      @unique @map("order_item_id")
  variantId    String      @map("variant_id")
  variantName  String      @map("variant_name")
  variantPrice Int         @map("variant_price")
  orderItem    OrderItem   @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  variant      MenuVariant @relation(fields: [variantId], references: [id])

  @@index([orderItemId])
  @@index([variantId])
  @@map("order_item_variants")
}

model OrderItemOption {
  id            String          @id @default(uuid())
  orderItemId   String          @map("order_item_id")
  optionValueId String          @map("option_value_id")
  optionName    String          @map("option_name")
  valueName     String          @map("value_name")
  priceModifier Int             @default(0) @map("price_modifier")
  optionValue   MenuOptionValue @relation(fields: [optionValueId], references: [id])
  orderItem     OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@index([optionValueId])
  @@map("order_item_options")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  details    String?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

enum Role {
  SUPER_ADMIN
  RESTAURANT_ADMIN
  MANAGER
  STAFF
}

enum OrderStatus {
  NEW
  ACCEPTED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}
