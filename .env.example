# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/great_delight_db?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-min-32-characters-long-change-in-production"

# Application
NEXT_PUBLIC_APP_NAME="GREAT DELIGHT"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Restaurant Configuration
NEXT_PUBLIC_RESTAURANT_SLUG="great-delight"
NEXT_PUBLIC_MAIN_BRANCH_SLUG="main"

# Image Storage (future)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_S3_BUCKET=

# Logging
LOG_LEVEL="info"

# Node Environment
NODE_ENV="development"
